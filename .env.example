# ============================================
#  IELTS 写作批改系统 — 环境变量模板
#  复制为 .env 并填入实际值
# ============================================

# 数据库
DATABASE_URL=mysql+asyncmy://ielts:ielts123@mysql:3306/ielts?charset=utf8mb4

# Redis (Celery broker + backend)
REDIS_URL=redis://redis:6379/0

# JWT 签名密钥。生产环境必须修改为 32+ 字节随机字符串。
# 留空则启动时自动生成（不持久，重启后旧 token 失效）
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# 评分单价（满分币）
GRADING_COST=1

# 上传目录
UPLOAD_DIR=/app/uploads

# Celery Worker 并发（每个 worker fork 数）
WORKER_CONCURRENCY=4

# 评分并发数（sub-dim 16 项 + dim-synth 4 项同时 LLM 调用上限）
# 数字越大越快，但 LLM provider 可能限流
GRADER_CONCURRENCY=4

# 管理员账户（首次启动时自动 seed）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOY  # 至少 12 字节随机字符串
ADMIN_EMAIL=admin@example.com

# 默认模型配置（管理后台可改）
DEFAULT_MODEL_BASE_URL=http://host.docker.internal:8000/v1
DEFAULT_MODEL_API_KEY=sk-temporarychat

# LLM 调用参数
LLM_TIMEOUT=180
LLM_MAX_TOKENS=8000
LLM_MAX_RETRIES=3

# 输入限制
MAX_ESSAY_CHARS=20000
MAX_IMAGE_BYTES=10485760
